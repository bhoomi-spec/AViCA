# syntax=docker/dockerfile:1
# AViCA Benchmark Deployment — AWS Graviton / Arm64
# Target instance: AWS c7g.xlarge (AWS Graviton3 Neoverse-V1, 4 vCPUs, 8 GiB DDR5 RAM)
# Cost reference: $0.1445 / hour (US-East-1 On-Demand, ~15% cost savings vs c6i)

FROM --platform=linux/arm64 node:22-bookworm-slim AS builder

WORKDIR /app

# Install build dependencies for aarch64 native compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Arm64 compiler flags for Neoverse V1
ENV CFLAGS="-O3 -march=armv8.4-a+crypto+fp16+dotprod -mtune=neoverse-v1"
ENV CXXFLAGS="-O3 -march=armv8.4-a+crypto+fp16+dotprod -mtune=neoverse-v1"

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==========================================
# Runtime Stage: AWS Graviton Optimized
# ==========================================
FROM --platform=linux/arm64 node:22-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV BENCHMARK_ARCH=arm64_graviton
ENV AWS_INSTANCE_TYPE=c7g.xlarge
ENV HOURLY_COST_USD=0.1445

# Install jemalloc for reduced memory contention across 4 Graviton vCPUs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjemalloc2 \
    procps \
    sysstat \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Preload jemalloc allocator
ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libjemalloc.so.2
ENV MALLOC_CONF="background_thread:true,metadata_thp:auto,dirty_decay_ms:2000,muzzy_decay_ms:2000"

# Node V8 flags optimized for Arm64 64-byte L1 cache lines
ENV NODE_OPTIONS="--max-semi-space-size=64 --max-old-space-size=4096"

COPY --from=builder /app /app
RUN mkdir -p /app/benchmark-results

ENTRYPOINT ["node", "scripts/run_graviton_benchmark.js"]
CMD ["--frames=200", "--env=graviton_c7g", "--out=/app/benchmark-results/graviton_telemetry.json"]
